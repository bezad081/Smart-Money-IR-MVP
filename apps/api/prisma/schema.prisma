generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum SyncTrigger {
  MANUAL
  SCHEDULED
}
enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model Instrument {
  id String @id @default(cuid())
  insCode String @unique
  symbol String
  name String?
  market String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([symbol])
}
model PortfolioItem {
  id String @id @default(cuid())
  insCode String @unique
  symbol String
  quantity Float @default(0)
  averageCost Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([symbol])
}
model DailyMarketData {
  id String @id @default(cuid())
  insCode String
  date DateTime @db.Date
  closePrice Float?
  previousClose Float?
  openPrice Float?
  highPrice Float?
  lowPrice Float?
  totalVolume Float @default(0)
  totalTrades Float @default(0)
  legalBuyVolume Float @default(0)
  legalSellVolume Float @default(0)
  legalBuyValue Float @default(0)
  legalSellValue Float @default(0)
  legalBuyCount Float @default(0)
  legalSellCount Float @default(0)
  retailBuyVolume Float @default(0)
  retailSellVolume Float @default(0)
  retailBuyValue Float @default(0)
  retailSellValue Float @default(0)
  retailBuyCount Float @default(0)
  retailSellCount Float @default(0)
  source String @default("tsetmc-cdn")
  fetchedAt DateTime @default(now())
  @@unique([insCode,date])
  @@index([date])
  @@index([insCode,date])
}
model SyncRun {
  id String @id @default(cuid())
  trigger SyncTrigger
  status SyncStatus @default(RUNNING)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  symbolsProcessed Int @default(0)
  recordsUpserted Int @default(0)
  message String?
}
